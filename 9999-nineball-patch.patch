Subject: [PATCH] Enable Video
---
Index: hw/display/virtio-gpu-virgl.c
IDEA additional info:
Subsystem: com.intellij.openapi.diff.impl.patch.CharsetEP
<+>UTF-8
===================================================================
diff --git a/hw/display/virtio-gpu-virgl.c b/hw/display/virtio-gpu-virgl.c
--- a/hw/display/virtio-gpu-virgl.c     (revision ccaea6b2656ec6eab966585f7b16438208f98de7)
+++ b/hw/display/virtio-gpu-virgl.c     (date 1773303475292)
@@ -15,6 +15,7 @@
 #include "qemu/error-report.h"
 #include "qemu/iov.h"
 #include "trace.h"
+#include "qemu/drm.h"
 #include "hw/virtio/virtio.h"
 #include "hw/virtio/virtio-gpu.h"
 #include "hw/virtio/virtio-gpu-bswap.h"
@@ -1067,6 +1068,15 @@
                                    qctx);
 }

+static int virgl_get_drm_fd(void *opaque)
+{
+    int fd = -1;
+
+    fd = qemu_drm_rendernode_open(NULL);
+
+    return fd;
+}
+
 static struct virgl_renderer_callbacks virtio_gpu_3d_cbs = {
 #if VIRGL_VERSION_MAJOR >= 1
     .version             = 3,
@@ -1080,6 +1090,7 @@
 #if VIRGL_VERSION_MAJOR >= 1
     .write_context_fence = virgl_write_context_fence,
 #endif
+    .get_drm_fd          = virgl_get_drm_fd,
 };

 static void virtio_gpu_print_stats(void *opaque)
@@ -1138,7 +1149,7 @@
 int virtio_gpu_virgl_init(VirtIOGPU *g)
 {
     int ret;
-    uint32_t flags = 0;
+    uint32_t flags = VIRGL_RENDERER_USE_VIDEO;
     VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);

 #if VIRGL_RENDERER_CALLBACKS_VERSION >= 4
Index: meson.build
IDEA additional info:
Subsystem: com.intellij.openapi.diff.impl.patch.CharsetEP
<+>UTF-8
===================================================================
diff --git a/meson.build b/meson.build
--- a/meson.build       (revision ccaea6b2656ec6eab966585f7b16438208f98de7)
+++ b/meson.build       (date 1773303391512)
@@ -1405,6 +1405,11 @@
                      method: 'pkg-config',
                      required: get_option('virglrenderer'))
 endif
+if virgl.version().version_compare('>= 1.0.0')
+  message('Enabling virglrenderer unstable APIs')
+  virgl = declare_dependency(compile_args: '-DVIRGL_RENDERER_UNSTABLE_APIS -DVIRGL_RENDERER_VENUS',
+                            dependencies: virgl)
+endif
 rutabaga = not_found
 if not get_option('rutabaga_gfx').auto() or have_system or have_vhost_user_gpu
   rutabaga = dependency('rutabaga_gfx_ffi',